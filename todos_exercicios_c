/*
 * Estruturas de Dados - Lista Simplesmente Encadeada
 * Exercicios 1 a 5 reunidos em um unico arquivo
 * Aluno: Gabriel Calegari Rodrigues
 *
 * Cada exercicio foi mantido intacto e pode ser executado pelo menu principal.
 * Como C nao possui namespaces, as variaveis globais (inicio/fim) e as funcoes
 * auxiliares que se repetiam (liberarLista, buscarPorCodigo) receberam um
 * sufixo com o numero do exercicio para evitar nomes duplicados.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* -------- Funcoes auxiliares compartilhadas -------- */
void limparBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) { }
}

void lerLinha(char *destino, int tamanho) {
    fgets(destino, tamanho, stdin);
    destino[strcspn(destino, "\n")] = '\0';
}


/* ============================================================
 * Exercicio 1 - Fila de chamados de suporte tecnico
 *
 * Cada novo chamado e inserido no FINAL da lista, preservando a
 * ordem de abertura.
 * ============================================================ */
typedef struct Chamado {
    int codigo;
    char solicitante[50];
    char descricao[100];
    int prioridade;
    struct Chamado *proximo;
} Chamado;

/* inicio1 guarda o primeiro no; fim1 guarda o ultimo (permite inserir no
 * final sem percorrer toda a lista). Ambos NULL = lista vazia. */
Chamado *inicio1 = NULL;
Chamado *fim1 = NULL;

/* Insere um chamado no final da lista */
void registrarChamado(void) {
    Chamado *novo = (Chamado *) malloc(sizeof(Chamado));
    if (novo == NULL) {
        printf("Erro: falha na alocacao de memoria.\n");
        return;
    }

    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Solicitante: ");
    fgets(novo->solicitante, sizeof(novo->solicitante), stdin);
    novo->solicitante[strcspn(novo->solicitante, "\n")] = '\0';
    printf("Descricao: ");
    fgets(novo->descricao, sizeof(novo->descricao), stdin);
    novo->descricao[strcspn(novo->descricao, "\n")] = '\0';
    printf("Prioridade (1-5): ");
    scanf("%d", &novo->prioridade);
    limparBuffer();

    novo->proximo = NULL;          /* novo sera o ultimo, aponta para NULL */

    if (inicio1 == NULL) {         /* lista vazia: novo e o primeiro E o ultimo */
        inicio1 = novo;
        fim1 = novo;
    } else {                       /* lista com elementos: encadeia no fim */
        fim1->proximo = novo;      /* o antigo ultimo aponta para o novo */
        fim1 = novo;               /* fim passa a ser o novo */
    }
    printf("Chamado registrado.\n");
}

/* Lista todos os chamados na ordem de abertura */
void listarChamados(void) {
    Chamado *atual = inicio1;      /* percorre usando um ponteiro auxiliar */
    if (atual == NULL) {
        printf("Nenhum chamado registrado.\n");
        return;
    }
    printf("\n--- Chamados ---\n");
    while (atual != NULL) {        /* para quando encontrar NULL */
        printf("Codigo: %d | Solicitante: %s | Prioridade: %d\n",
               atual->codigo, atual->solicitante, atual->prioridade);
        printf("  Descricao: %s\n", atual->descricao);
        atual = atual->proximo;    /* avanca para o proximo no */
    }
}

/* Busca um chamado pelo codigo */
void buscarChamado(void) {
    int codigo;
    Chamado *atual = inicio1;
    printf("Codigo a buscar: ");
    scanf("%d", &codigo);
    limparBuffer();

    while (atual != NULL) {
        if (atual->codigo == codigo) {
            printf("Encontrado: %s | Prioridade: %d\n",
                   atual->solicitante, atual->prioridade);
            return;
        }
        atual = atual->proximo;
    }
    printf("Chamado nao encontrado.\n");
}

/* Conta quantos chamados existem percorrendo a lista */
void contarChamados(void) {
    int total = 0;
    Chamado *atual = inicio1;
    while (atual != NULL) {
        total++;
        atual = atual->proximo;
    }
    printf("Total de chamados: %d\n", total);
}

/* Remove o primeiro chamado da lista */
void removerPrimeiro(void) {
    if (inicio1 == NULL) {         /* teste: lista vazia */
        printf("Lista vazia. Nada a remover.\n");
        return;
    }

    Chamado *removido = inicio1;   /* guarda o endereco antes de remover */
    inicio1 = inicio1->proximo;    /* inicio passa a apontar para o segundo */

    if (inicio1 == NULL) {         /* teste: era o unico elemento */
        fim1 = NULL;               /* inicio e fim viram NULL = lista vazia */
    }

    free(removido);                /* libera a memoria do no removido */
    printf("Primeiro chamado removido.\n");
}

/* Libera toda a memoria antes de encerrar */
void liberarLista1(void) {
    Chamado *atual = inicio1;
    while (atual != NULL) {
        Chamado *proximo = atual->proximo;  /* guarda o proximo ANTES do free */
        free(atual);
        atual = proximo;
    }
    inicio1 = NULL;
    fim1 = NULL;
}

/* Menu do Exercicio 1 */
void exercicio1(void) {
    int opcao;
    do {
        printf("\n=== CHAMADOS DE SUPORTE ===\n");
        printf("1 - Registrar chamado\n");
        printf("2 - Listar chamados\n");
        printf("3 - Buscar por codigo\n");
        printf("4 - Quantidade de chamados\n");
        printf("5 - Remover primeiro chamado\n");
        printf("0 - Encerrar\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        limparBuffer();

        switch (opcao) {
            case 1: registrarChamado(); break;
            case 2: listarChamados(); break;
            case 3: buscarChamado(); break;
            case 4: contarChamados(); break;
            case 5: removerPrimeiro(); break;
            case 0: liberarLista1(); printf("Encerrando...\n"); break;
            default: printf("Opcao invalida.\n");
        }
    } while (opcao != 0);
}


/* ============================================================
 * Exercicio 2 - Cadastro de imoveis de uma imobiliaria
 *
 * Permite inserir, buscar, alterar e remover imoveis em qualquer
 * posicao. Usa os ponteiros auxiliares atual e anterior.
 * ============================================================ */
typedef struct Imovel {
    int codigo;
    char bairro[40];
    char tipo[30];
    int dormitorios;
    float valor;
    struct Imovel *proximo;
} Imovel;

Imovel *inicio2 = NULL;
Imovel *fim2 = NULL;

void inserirImovel(void) {
    Imovel *novo = (Imovel *) malloc(sizeof(Imovel));
    if (novo == NULL) {
        printf("Erro de alocacao.\n");
        return;
    }
    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Bairro: ");
    lerLinha(novo->bairro, sizeof(novo->bairro));
    printf("Tipo: ");
    lerLinha(novo->tipo, sizeof(novo->tipo));
    printf("Dormitorios: ");
    scanf("%d", &novo->dormitorios);
    printf("Valor: ");
    scanf("%f", &novo->valor);
    limparBuffer();

    novo->proximo = NULL;
    if (inicio2 == NULL) {
        inicio2 = novo;
        fim2 = novo;
    } else {
        fim2->proximo = novo;
        fim2 = novo;
    }
    printf("Imovel inserido.\n");
}

void listarImoveis(void) {
    Imovel *atual = inicio2;
    if (atual == NULL) {
        printf("Catalogo vazio.\n");
        return;
    }
    printf("\n--- Imoveis ---\n");
    while (atual != NULL) {
        printf("Codigo: %d | %s | %s | %d dorm | R$ %.2f\n",
               atual->codigo, atual->bairro, atual->tipo,
               atual->dormitorios, atual->valor);
        atual = atual->proximo;
    }
}

void buscarImovel(void) {
    int codigo;
    Imovel *atual = inicio2;
    printf("Codigo a buscar: ");
    scanf("%d", &codigo);
    limparBuffer();

    while (atual != NULL && atual->codigo != codigo) {
        atual = atual->proximo;
    }
    if (atual == NULL) {
        printf("Imovel nao encontrado.\n");
    } else {
        printf("Encontrado: %s | %s | R$ %.2f\n",
               atual->bairro, atual->tipo, atual->valor);
    }
}

void listarPorBairro(void) {
    char bairro[40];
    Imovel *atual = inicio2;
    int achou = 0;
    printf("Bairro: ");
    lerLinha(bairro, sizeof(bairro));

    while (atual != NULL) {
        if (strcmp(atual->bairro, bairro) == 0) {
            printf("Codigo: %d | %s | R$ %.2f\n",
                   atual->codigo, atual->tipo, atual->valor);
            achou = 1;
        }
        atual = atual->proximo;
    }
    if (!achou) {
        printf("Nenhum imovel nesse bairro.\n");
    }
}

void alterarValor(void) {
    int codigo;
    float novoValor;
    Imovel *atual = inicio2;
    printf("Codigo do imovel: ");
    scanf("%d", &codigo);
    limparBuffer();

    while (atual != NULL && atual->codigo != codigo) {
        atual = atual->proximo;
    }
    if (atual == NULL) {
        printf("Imovel nao encontrado.\n");
        return;
    }
    printf("Novo valor: ");
    scanf("%f", &novoValor);
    limparBuffer();
    atual->valor = novoValor;
    printf("Valor atualizado.\n");
}

/* Remocao em qualquer posicao: usa atual e anterior */
void removerImovel(void) {
    int codigo;
    Imovel *atual = inicio2;
    Imovel *anterior = NULL;   /* anterior permanece NULL enquanto no inicio */

    if (inicio2 == NULL) {
        printf("Catalogo vazio.\n");
        return;
    }
    printf("Codigo a remover: ");
    scanf("%d", &codigo);
    limparBuffer();

    while (atual != NULL && atual->codigo != codigo) {
        anterior = atual;          /* anterior acompanha o percurso */
        atual = atual->proximo;
    }

    if (atual == NULL) {
        printf("Imovel nao encontrado.\n");
        return;
    }

    if (anterior == NULL) {
        /* Removendo o PRIMEIRO elemento */
        inicio2 = atual->proximo;
    } else {
        /* Removendo do MEIO ou do FIM: salta o no atual */
        anterior->proximo = atual->proximo;
    }

    if (atual == fim2) {
        /* Se removeu o ULTIMO, atualiza o fim */
        fim2 = anterior;
    }

    free(atual);                   /* libera o no removido */
    printf("Imovel removido.\n");
}

void exibirMaiorValor(void) {
    Imovel *atual = inicio2;
    Imovel *maior = inicio2;
    if (inicio2 == NULL) {
        printf("Catalogo vazio.\n");
        return;
    }
    while (atual != NULL) {
        if (atual->valor > maior->valor) {
            maior = atual;
        }
        atual = atual->proximo;
    }
    printf("Maior valor: codigo %d | %s | R$ %.2f\n",
           maior->codigo, maior->bairro, maior->valor);
}

void liberarLista2(void) {
    Imovel *atual = inicio2;
    while (atual != NULL) {
        Imovel *proximo = atual->proximo;
        free(atual);
        atual = proximo;
    }
    inicio2 = NULL;
    fim2 = NULL;
}

/* Menu do Exercicio 2 */
void exercicio2(void) {
    int opcao;
    do {
        printf("\n=== IMOBILIARIA ===\n");
        printf("1 - Inserir imovel\n");
        printf("2 - Listar imoveis\n");
        printf("3 - Buscar por codigo\n");
        printf("4 - Listar por bairro\n");
        printf("5 - Alterar valor\n");
        printf("6 - Remover por codigo\n");
