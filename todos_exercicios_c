        limparBuffer();

        switch (opcao) {
            case 1: inserirImovel(); break;
            case 2: listarImoveis(); break;
            case 3: buscarImovel(); break;
            case 4: listarPorBairro(); break;
            case 5: alterarValor(); break;
            case 6: removerImovel(); break;
