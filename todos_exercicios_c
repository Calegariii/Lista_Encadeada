        }
    } while (opcao != 0);
}


/* ============================================================
 * Exercicio 3 - Controle de estoque de produtos
 *
 * Mantem os produtos em ordem crescente de codigo (insercao
 * ordenada). Usa os ponteiros auxiliares novo, atual e anterior.
 * ============================================================ */
typedef struct Produto {
    int codigo;
    char descricao[50];
    int quantidade;
    float preco;
    struct Produto *proximo;
} Produto;

Produto *inicio3 = NULL;

Produto *buscarProdutoPorCodigo(int codigo, Produto **anteriorSaida) {
    Produto *atual = inicio3;
    Produto *anterior = NULL;
    while (atual != NULL && atual->codigo < codigo) {
        anterior = atual;
        atual = atual->proximo;
    }
    if (anteriorSaida != NULL) {
        *anteriorSaida = anterior;
    }
    return atual;
}

/* Insere mantendo a ordem crescente do codigo */
void inserirProduto(void) {
    Produto *novo = (Produto *) malloc(sizeof(Produto));
    if (novo == NULL) {
        printf("Erro de alocacao.\n");
        return;
    }
    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Descricao: ");
    lerLinha(novo->descricao, sizeof(novo->descricao));
    printf("Quantidade: ");
    scanf("%d", &novo->quantidade);
    printf("Preco: ");
    scanf("%f", &novo->preco);
    limparBuffer();

    Produto *anterior = NULL;
    Produto *atual = buscarProdutoPorCodigo(novo->codigo, &anterior);

    if (atual != NULL && atual->codigo == novo->codigo) {
        printf("Erro: codigo duplicado.\n");
        free(novo);
        return;
    }

    /* Ligacoes do desafio de raciocinio do Exercicio 3 */
    novo->proximo = atual;         /* novo aponta para quem vem depois */
    if (anterior == NULL) {
        /* Inserindo no INICIO (codigo menor que todos) */
        inicio3 = novo;
    } else {
        anterior->proximo = novo;  /* anterior aponta para o novo */
    }
    printf("Produto inserido.\n");
}

void registrarEntrada(void) {
    int codigo, qtd;
    Produto *atual;
    printf("Codigo: ");
    scanf("%d", &codigo);
    limparBuffer();
    atual = buscarProdutoPorCodigo(codigo, NULL);
    if (atual == NULL || atual->codigo != codigo) {
        printf("Produto nao encontrado.\n");
        return;
    }
    printf("Unidades de entrada: ");
    scanf("%d", &qtd);
    limparBuffer();
    atual->quantidade += qtd;
    printf("Entrada registrada. Novo estoque: %d\n", atual->quantidade);
}

void registrarSaida(void) {
    int codigo, qtd;
    Produto *atual;
    printf("Codigo: ");
    scanf("%d", &codigo);
    limparBuffer();
    atual = buscarProdutoPorCodigo(codigo, NULL);
    if (atual == NULL || atual->codigo != codigo) {
        printf("Produto nao encontrado.\n");
        return;
    }
    printf("Unidades de saida: ");
    scanf("%d", &qtd);
    limparBuffer();
    if (qtd > atual->quantidade) {
        printf("Erro: saida maior que o estoque (%d).\n", atual->quantidade);
        return;
    }
    atual->quantidade -= qtd;
    printf("Saida registrada. Novo estoque: %d\n", atual->quantidade);
}

void buscarProduto(void) {
    int codigo;
    Produto *atual;
    printf("Codigo a buscar: ");
    scanf("%d", &codigo);
    limparBuffer();
    atual = buscarProdutoPorCodigo(codigo, NULL);
    if (atual == NULL || atual->codigo != codigo) {
        printf("Produto nao encontrado.\n");
    } else {
        printf("%d | %s | %d un | R$ %.2f\n",
               atual->codigo, atual->descricao, atual->quantidade, atual->preco);
    }
}

void listarProdutos(void) {
    Produto *atual = inicio3;
    if (atual == NULL) {
        printf("Estoque vazio.\n");
        return;
    }
    printf("\n--- Produtos (ordem crescente de codigo) ---\n");
    while (atual != NULL) {
        printf("%d | %s | %d un | R$ %.2f\n",
               atual->codigo, atual->descricao, atual->quantidade, atual->preco);
        atual = atual->proximo;
    }
}

void listarEstoqueBaixo(void) {
    Produto *atual = inicio3;
    int achou = 0;
    while (atual != NULL) {
        if (atual->quantidade < 5) {
            printf("%d | %s | %d un\n",
                   atual->codigo, atual->descricao, atual->quantidade);
            achou = 1;
        }
        atual = atual->proximo;
    }
    if (!achou) {
        printf("Nenhum produto com menos de 5 unidades.\n");
    }
}

/* Remove somente produtos com estoque zero */
void removerZerados(void) {
    Produto *atual = inicio3;
    Produto *anterior = NULL;
    int removidos = 0;

    while (atual != NULL) {
        if (atual->quantidade == 0) {
            Produto *removido = atual;
            if (anterior == NULL) {
                inicio3 = atual->proximo;
                atual = inicio3;
            } else {
                anterior->proximo = atual->proximo;
                atual = atual->proximo;
            }
            free(removido);
            removidos++;
        } else {
            anterior = atual;
            atual = atual->proximo;
        }
    }
    printf("Produtos removidos: %d\n", removidos);
}

void liberarLista3(void) {
    Produto *atual = inicio3;
    while (atual != NULL) {
        Produto *proximo = atual->proximo;
        free(atual);
        atual = proximo;
    }
    inicio3 = NULL;
}

/* Menu do Exercicio 3 */
void exercicio3(void) {
    int opcao;
    do {
        printf("\n=== ESTOQUE ===\n");
        printf("1 - Inserir produto\n");
        printf("2 - Registrar entrada\n");
        printf("3 - Registrar saida\n");
        printf("4 - Buscar produto\n");
        printf("5 - Listar produtos\n");
        printf("6 - Produtos com menos de 5 unidades\n");
        printf("7 - Remover produtos zerados\n");
        printf("0 - Encerrar\n");
        printf("Opcao: ");
        scanf("%d", &opcao);
        limparBuffer();

        switch (opcao) {
            case 1: inserirProduto(); break;
            case 2: registrarEntrada(); break;
            case 3: registrarSaida(); break;
            case 4: buscarProduto(); break;
            case 5: listarProdutos(); break;
            case 6: listarEstoqueBaixo(); break;
            case 7: removerZerados(); break;
            case 0: liberarLista3(); printf("Encerrando...\n"); break;
            default: printf("Opcao invalida.\n");
        }
    } while (opcao != 0);
}


/* ============================================================
 * Exercicio 4 - Playlist de musicas
 *
 * Insere, remove e reposiciona faixas. Destaca a insercao APOS um
 * no especifico e a movimentacao de uma musica para o inicio.
 * ============================================================ */
typedef struct Musica {
    int codigo;
    char titulo[50];
    char artista[50];
    int duracaoSegundos;
    struct Musica *proximo;
} Musica;

Musica *inicio4 = NULL;
Musica *fim4 = NULL;

Musica *buscarMusicaPorCodigo(int codigo, Musica **anteriorSaida) {
    Musica *atual = inicio4;
    Musica *anterior = NULL;
    while (atual != NULL && atual->codigo != codigo) {
        anterior = atual;
        atual = atual->proximo;
    }
    if (anteriorSaida != NULL) {
        *anteriorSaida = anterior;
    }
    return atual;
}

/* Adiciona uma musica ao final */
void adicionarMusica(void) {
    Musica *novo = (Musica *) malloc(sizeof(Musica));
    if (novo == NULL) {
        printf("Erro de alocacao.\n");
        return;
    }
    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Titulo: ");
    lerLinha(novo->titulo, sizeof(novo->titulo));
    printf("Artista: ");
    lerLinha(novo->artista, sizeof(novo->artista));
    printf("Duracao (segundos): ");
    scanf("%d", &novo->duracaoSegundos);
    limparBuffer();

    novo->proximo = NULL;
    if (inicio4 == NULL) {
        inicio4 = novo;
        fim4 = novo;
    } else {
        fim4->proximo = novo;
        fim4 = novo;
    }
    printf("Musica adicionada.\n");
}

/* Insere uma musica depois de outra musica informada */
void inserirDepois(void) {
    int codigoRef;
    Musica *atual;
    Musica *novo = (Musica *) malloc(sizeof(Musica));
    if (novo == NULL) {
        printf("Erro de alocacao.\n");
        return;
    }
    printf("Codigo da musica de referencia: ");
    scanf("%d", &codigoRef);
    limparBuffer();

    atual = buscarMusicaPorCodigo(codigoRef, NULL);
    if (atual == NULL) {
        printf("Musica de referencia nao encontrada.\n");
        free(novo);
        return;
    }

    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Titulo: ");
    lerLinha(novo->titulo, sizeof(novo->titulo));
    printf("Artista: ");
    lerLinha(novo->artista, sizeof(novo->artista));
    printf("Duracao (segundos): ");
    scanf("%d", &novo->duracaoSegundos);
    limparBuffer();

    /* Ligacoes da insercao apos o no atual (ordem importa) */
    novo->proximo = atual->proximo;  /* 1) novo aponta para o sucessor */
    atual->proximo = novo;           /* 2) atual aponta para o novo */

    if (novo->proximo == NULL) {     /* inserido apos o ultimo */
        fim4 = novo;
    }
    printf("Musica inserida apos o codigo %d.\n", codigoRef);
}

void listarPlaylist(void) {
    Musica *atual = inicio4;
    if (atual == NULL) {
        printf("Playlist vazia.\n");
        return;
    }
    printf("\n--- Playlist ---\n");
    while (atual != NULL) {
        printf("%d | %s - %s (%d s)\n",
               atual->codigo, atual->titulo, atual->artista, atual->duracaoSegundos);
        atual = atual->proximo;
    }
}

void buscarPorArtista(void) {
    char artista[50];
    Musica *atual = inicio4;
    int achou = 0;
    printf("Artista: ");
    lerLinha(artista, sizeof(artista));
    while (atual != NULL) {
        if (strcmp(atual->artista, artista) == 0) {
            printf("%d | %s (%d s)\n",
                   atual->codigo, atual->titulo, atual->duracaoSegundos);
            achou = 1;
        }
        atual = atual->proximo;
    }
    if (!achou) {
        printf("Nenhuma musica desse artista.\n");
    }
}

void removerMusica(void) {
    int codigo;
    Musica *anterior = NULL;
    Musica *atual;
    printf("Codigo a remover: ");
    scanf("%d", &codigo);
    limparBuffer();

    atual = buscarMusicaPorCodigo(codigo, &anterior);
    if (atual == NULL) {
        printf("Musica nao encontrada.\n");
        return;
    }

    if (anterior == NULL) {
        inicio4 = atual->proximo;
    } else {
        anterior->proximo = atual->proximo;
    }
    if (atual == fim4) {
        fim4 = anterior;
    }
    free(atual);
    printf("Musica removida.\n");
}

void calcularDuracaoTotal(void) {
    Musica *atual = inicio4;
    int total = 0;
    while (atual != NULL) {
        total += atual->duracaoSegundos;
        atual = atual->proximo;
    }
    printf("Duracao total: %d s (%d min %d s)\n", total, total / 60, total % 60);
}

/* Move uma musica existente para o inicio */
void moverParaInicio(void) {
    int codigo;
    Musica *anterior = NULL;
    Musica *atual;
    printf("Codigo da musica a mover: ");
    scanf("%d", &codigo);
    limparBuffer();

    atual = buscarMusicaPorCodigo(codigo, &anterior);
    if (atual == NULL) {
        printf("Musica nao encontrada.\n");
        return;
    }
    if (anterior == NULL) {
        printf("A musica ja esta no inicio.\n");
        return;
    }

    /* Desencadeia o no da posicao atual */
    anterior->proximo = atual->proximo;
    if (atual == fim4) {
        fim4 = anterior;             /* era o ultimo: fim volta para anterior */
    }

    /* Reencadeia no inicio */
    atual->proximo = inicio4;
    inicio4 = atual;                 /* inicio passa a apontar para a musica */
    printf("Musica movida para o inicio.\n");
}

void liberarLista4(void) {
    Musica *atual = inicio4;
    while (atual != NULL) {
        Musica *proximo = atual->proximo;
        free(atual);
        atual = proximo;
    }
    inicio4 = NULL;
    fim4 = NULL;
}

