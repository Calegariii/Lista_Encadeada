/* ============================================================
 * Exercicio 5 - Sistema de entregas de uma transportadora
 *
 * Remove TODAS as entregas com estado "Entregue" durante um unico
 * percurso, tratando elementos consecutivos, e esvazia a lista ao
 * encerrar.
 * ============================================================ */
typedef struct Entrega {
    int codigo;
    char cliente[50];
    char endereco[100];
    char status[20];
    float distanciaKm;
    struct Entrega *proximo;
} Entrega;

Entrega *inicio5 = NULL;
Entrega *fim5 = NULL;

void cadastrarEntrega(void) {
    Entrega *novo = (Entrega *) malloc(sizeof(Entrega));
    if (novo == NULL) {
        printf("Erro de alocacao.\n");
        return;
    }
    printf("Codigo: ");
    scanf("%d", &novo->codigo);
    limparBuffer();
    printf("Cliente: ");
    lerLinha(novo->cliente, sizeof(novo->cliente));
    printf("Endereco: ");
    lerLinha(novo->endereco, sizeof(novo->endereco));
    printf("Status (Pendente/Em rota/Entregue): ");
    lerLinha(novo->status, sizeof(novo->status));
    printf("Distancia (km): ");
    scanf("%f", &novo->distanciaKm);
    limparBuffer();

    novo->proximo = NULL;
    if (inicio5 == NULL) {
        inicio5 = novo;
        fim5 = novo;
    } else {
        fim5->proximo = novo;
        fim5 = novo;
    }
    printf("Entrega cadastrada.\n");
}

void listarEntregas(void) {
    Entrega *atual = inicio5;
    if (atual == NULL) {
        printf("Nenhuma entrega cadastrada.\n");
        return;
    }
    printf("\n--- Entregas ---\n");
    while (atual != NULL) {
        printf("%d | %s | %s | %s | %.1f km\n",
               atual->codigo, atual->cliente, atual->endereco,
               atual->status, atual->distanciaKm);
        atual = atual->proximo;
    }
}

void buscarEntrega(void) {
    int codigo;
    Entrega *atual = inicio5;
    printf("Codigo a buscar: ");
    scanf("%d", &codigo);
    limparBuffer();
    while (atual != NULL && atual->codigo != codigo) {
        atual = atual->proximo;
    }
    if (atual == NULL) {
        printf("Entrega nao encontrada.\n");
    } else {
        printf("%s | %s | %s | %.1f km\n",
               atual->cliente, atual->endereco, atual->status, atual->distanciaKm);
    }
}

void alterarEstado(void) {
    int codigo;
    Entrega *atual = inicio5;
    printf("Codigo: ");
    scanf("%d", &codigo);
    limparBuffer();
    while (atual != NULL && atual->codigo != codigo) {
        atual = atual->proximo;
    }
    if (atual == NULL) {
        printf("Entrega nao encontrada.\n");
        return;
    }
    printf("Novo status: ");
    lerLinha(atual->status, sizeof(atual->status));
    printf("Estado alterado.\n");
}

void contarPendentes(void) {
    Entrega *atual = inicio5;
    int total = 0;
    while (atual != NULL) {
        if (strcmp(atual->status, "Pendente") == 0) {
            total++;
        }
        atual = atual->proximo;
    }
    printf("Entregas pendentes: %d\n", total);
}

void calcularDistanciaTotal(void) {
    Entrega *atual = inicio5;
    float total = 0.0f;
    while (atual != NULL) {
        total += atual->distanciaKm;
        atual = atual->proximo;
    }
    printf("Distancia total: %.1f km\n", total);
}

/* Remove todas as entregas com estado "Entregue" em um unico percurso */
void removerEntregues(void) {
    Entrega *atual = inicio5;
    Entrega *anterior = NULL;
    int removidos = 0;

    while (atual != NULL) {
        if (strcmp(atual->status, "Entregue") == 0) {
            Entrega *removido = atual;

            if (anterior == NULL) {
                /* Removendo o inicio: inicio avanca */
                inicio5 = atual->proximo;
                atual = inicio5;
            } else {
                /* Salta o no removido; anterior NAO avanca (pode haver
                 * outra entrega "Entregue" logo em seguida) */
                anterior->proximo = atual->proximo;
                atual = atual->proximo;
            }

            if (removido == fim5) {
                fim5 = anterior;      /* removeu o ultimo: atualiza fim */
            }

            free(removido);          /* libera sem usar o ponteiro depois */
            removidos++;
        } else {
            anterior = atual;        /* so avanca anterior se nao removeu */
            atual = atual->proximo;
        }
    }
    printf("Entregas removidas: %d\n", removidos);
}

/* Esvazia completamente a lista (desafio de raciocinio do Exercicio 5) */
void liberarLista5(Entrega **inicio, Entrega **fim) {
    Entrega *atual = *inicio;
    while (atual != NULL) {
        Entrega *proximo = atual->proximo;  /* guarda o proximo ANTES do free */
        free(atual);
        atual = proximo;
    }
    *inicio = NULL;
    *fim = NULL;
}

